# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-credentials.json
# Local emulators only, never configure these in production:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098
